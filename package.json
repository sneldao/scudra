{
  "name": "scudra",
  "version": "0.1.0",
  "private": true,
  "description": "Scudra \u2014 a lab for cloud-native agents. Recipes, experiences, and thought leadership for browsers, sandboxes, and desktops that run in the cloud.",
  "license": "MIT",
  "author": "Scudra Contributors",
  "type": "module",
  "scripts": {
    "dev:site": "pnpm --filter site dev",
    "dev:blindspot": "pnpm --filter blindspot dev",
    "dev:witness": "pnpm --filter witness dev",
    "build:site": "pnpm --filter site build",
    "build:blindspot": "pnpm --filter blindspot build",
    "build:witness": "pnpm --filter witness build",
    "dev:analyst": "pnpm --filter @scudra/analyst dev",
    "build:analyst": "pnpm --filter @scudra/analyst build",
    "dev:builder": "pnpm --filter builder dev",
    "build:builder": "pnpm --filter builder build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "prepare": "bash scripts/install-hooks.sh",
    "dev:analyst:mock": "pnpm --filter @scudra/analyst dev:mock"
  },
  "devDependencies": {
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.5.0",
    "turbo": "^2.4.0",
    "typescript-eslint": "^8.24.0"
  },
  "packageManager": "pnpm@9.15.0"
}
