---
import Layout from "../../layouts/Layout.astro"
import { recipes } from "../../data/recipes.ts"

const primitiveLabel: Record<string, string> = {
  browser: "Browser",
  sandbox: "Sandbox",
  desktop: "Desktop",
}
---

<Layout title="Recipes — Scudra" description="A collection of cloud agent recipes.">
  <section class="sc-container py-20">
    <p class="text-xs uppercase tracking-[0.12em] text-ink-muted mb-4" data-reveal>
      Recipes
    </p>
    <h1 class="font-serif text-[clamp(2.25rem,5vw,3.5rem)] leading-[1.1] tracking-tight mb-4" data-reveal>
      Cloud agent recipes
    </h1>
    <p class="text-ink-muted max-w-[55ch] mb-12 leading-relaxed" data-reveal>
      Each recipe is a real, runnable agent. Study it, fork it, and adapt it to your own work.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {recipes.map((recipe) => (
        <a
          href={`/recipes/${recipe.slug}`}
          class="group block p-6 bg-paper-warm rounded-sc border border-black/5 hover:border-accent/30 transition-colors no-underline text-inherit"
          data-reveal
        >
          <div class="flex flex-wrap gap-2 mb-3">
            {recipe.primitives.map((p) => (
              <span class="text-[0.65rem] uppercase tracking-[0.08em] px-2 py-1 bg-ink text-paper rounded-full">
                {primitiveLabel[p]}
              </span>
            ))}
          </div>
          <h2 class="font-serif text-xl mb-2 group-hover:text-accent transition-colors">{recipe.title}</h2>
          <p class="text-ink-muted leading-relaxed text-sm">{recipe.tagline}</p>
          <span class="inline-block mt-4 text-sm text-accent font-medium">
            Read the recipe →
          </span>
        </a>
      ))}
    </div>
  </section>
</Layout>
