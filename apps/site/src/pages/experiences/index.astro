---
import Layout from "../../layouts/Layout.astro"
import { EXPERIENCE_URLS } from "@scudra/shared"
---

<Layout title="Experiences — Scudra" description="Interactive cloud agent experiences built by Scudra.">
  <section class="sc-container py-20">
    <p class="text-xs uppercase tracking-[0.12em] text-ink-muted mb-4" data-reveal>
      Experiences
    </p>
    <h1 class="font-serif text-[clamp(2.25rem,5vw,3.5rem)] leading-[1.1] tracking-tight mb-4" data-reveal>
      Interactive experiences
    </h1>
    <p class="text-ink-muted max-w-[55ch] mb-12 leading-relaxed" data-reveal>
      These are not static demos. They are real agents you can run, inspect, and fork.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <article id="blindspot" class="p-6 bg-paper-warm rounded-sc border border-black/5" data-reveal>
        <p class="text-[0.7rem] uppercase tracking-[0.08em] text-ink-muted mb-3">Live</p>
        <h2 class="font-serif text-2xl mb-2">Blindspot</h2>
        <p class="text-ink-muted leading-relaxed mb-6">
          Look up an ENS name and watch an agent quietly investigate it — resolving the wallet,
          checking onchain holdings, and digging up off-chain context — then hand you a verdict.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href={EXPERIENCE_URLS.blindspot} class="sc-button-accent">Open the dossier</a>
          <a href="/recipes/blindspot" class="sc-button-secondary">Read the recipe</a>
        </div>
      </article>

      <article class="p-6 bg-paper-warm rounded-sc border border-black/5 opacity-65" data-reveal>
        <p class="text-[0.7rem] uppercase tracking-[0.08em] text-ink-muted mb-3">Coming soon</p>
        <h2 class="font-serif text-2xl mb-2">The Witness</h2>
        <p class="text-ink-muted leading-relaxed mb-6">
          The same URL, seen from three countries at once. Enter a link and watch what the world
          actually sees — through residential IPs, from browsers that leave no trace of you.
        </p>
        <span class="inline-block sc-button-secondary opacity-75 cursor-default">
          In the lab
        </span>
      </article>

      <article class="p-6 bg-paper-warm rounded-sc border border-black/5 opacity-65" data-reveal>
        <p class="text-[0.7rem] uppercase tracking-[0.08em] text-ink-muted mb-3">Coming soon</p>
        <h2 class="font-serif text-2xl mb-2">The Builder</h2>
        <p class="text-ink-muted leading-relaxed mb-6">
          Describe a small app and watch an agent plan it, write it, and boot it in a disposable
          sandbox — then hand you a live URL that dies with the machine that hosted it.
        </p>
        <span class="inline-block sc-button-secondary opacity-75 cursor-default">
          In the lab
        </span>
      </article>
    </div>
  </section>
</Layout>
