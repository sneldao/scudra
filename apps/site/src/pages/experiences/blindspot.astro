---
import Layout from "../../layouts/Layout.astro"
import { EXPERIENCE_URLS } from "@scudra/shared"

// When a live interactive deployment is configured, the primary CTA leads
// straight into the 3D dossier. Otherwise we fall back to "run it locally".
const liveUrl = EXPERIENCE_URLS.blindspot
const hasLive = liveUrl !== "/experiences/blindspot"
---

<Layout
  title="Blindspot — Scudra"
  description="A privacy-preserving onchain investigation agent built with cloud browsers and sandboxes."
>
  <article class="sc-container py-20 max-w-[72ch]" data-reveal>
    <p class="text-xs uppercase tracking-[0.12em] text-ink-muted mb-4">
      <a href="/experiences" class="no-underline text-inherit hover:text-ink">← Experiences</a>
    </p>

    <h1 class="font-serif text-[clamp(2.25rem,5vw,3.5rem)] leading-[1.1] tracking-tight mb-4">
      Blindspot
    </h1>
    <p class="text-lg text-ink-muted leading-relaxed mb-8">
      A privacy-preserving onchain investigation agent. Look up an ENS name and watch an agent quietly
      investigate it — resolving the wallet, checking onchain holdings, and digging up off-chain context —
      then hand you a verdict. It does all of it from a disposable cloud machine that vanishes when you're done.
    </p>

    <div class="flex flex-wrap gap-3 mb-12">
      {hasLive ? (
        <a href={liveUrl} class="sc-button-accent">
          Open the live dossier
        </a>
      ) : (
        <a
          href="https://github.com/scudra/scudra/tree/main/apps/blindspot"
          class="sc-button-primary"
        >
          Run it locally
        </a>
      )}
      <a
        href="/recipes/blindspot"
        class="sc-button-secondary"
      >
        Read the recipe
      </a>
    </div>

    <div class="p-6 bg-paper-warm rounded-sc border border-black/5">
      <h2 class="font-serif text-2xl mb-4">What it demonstrates</h2>
      <ul class="flex flex-col gap-3 text-ink-muted leading-relaxed list-disc pl-5">
        <li><strong>Ephemeral sandbox.</strong> Mobula API calls run inside a Solari sandbox, so the investigator's IP never touches the data provider.</li>
        <li><strong>Stealth browser.</strong> Off-chain enrichment is fetched through a residential proxy, masking the investigator's fingerprint.</li>
        <li><strong>Session recording.</strong> The full browser session can be recorded and downloaded for audit.</li>
        <li><strong>Teardown.</strong> Sandbox is killed, browser is closed, and state is removed after the investigation.</li>
      </ul>
    </div>
  </article>
</Layout>
