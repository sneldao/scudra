---
import Layout from "../layouts/Layout.astro"
import { PRODUCT } from "@scudra/shared"
---

<Layout>
  <section class="pt-24 pb-16">
    <div class="sc-container">
      <p class="text-xs uppercase tracking-[0.12em] text-ink-muted mb-4" data-reveal>
        A lab for cloud-native agents
      </p>
      <h1 class="font-serif text-[clamp(3rem,8vw,5rem)] leading-[1.05] tracking-tighter max-w-[16ch]" data-reveal>
        Software that runs, acts, and disappears in the cloud.
      </h1>
      <p class="text-lg text-ink-muted max-w-[55ch] mt-6 leading-relaxed" data-reveal>
        Scudra is a collection of real-world recipes and experiences for cloud agents: ephemeral browsers, sandboxes, and desktops that do work on your behalf and leave no trace.
      </p>
      <div class="flex flex-wrap gap-3 mt-8" data-reveal>
        <a href="/recipes" class="sc-button-primary">Browse recipes</a>
        <a href="/experiences" class="sc-button-secondary">Explore experiences</a>
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper-warm">
    <div class="sc-container">
      <h2 class="font-serif text-3xl mb-8" data-reveal>Three primitives</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <article class="p-6 bg-paper rounded-sc border border-black/5" data-reveal>
          <h3 class="text-lg font-medium mb-2">Browser</h3>
          <p class="text-ink-muted leading-relaxed">A web agent that can see, click, and navigate without ever touching your local machine.</p>
        </article>
        <article class="p-6 bg-paper rounded-sc border border-black/5" data-reveal>
          <h3 class="text-lg font-medium mb-2">Sandbox</h3>
          <p class="text-ink-muted leading-relaxed">A disposable VM that boots in seconds, runs code, and is destroyed when the work is done.</p>
        </article>
        <article class="p-6 bg-paper rounded-sc border border-black/5" data-reveal>
          <h3 class="text-lg font-medium mb-2">Desktop</h3>
          <p class="text-ink-muted leading-relaxed">A remote GUI for tasks that need a screen: click, type, and observe like a human operator.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="sc-container">
      <h2 class="font-serif text-3xl mb-4" data-reveal>What we are building</h2>
      <p class="text-ink-muted max-w-[60ch] mb-8 leading-relaxed" data-reveal>
        The lab is the top of the funnel. Underneath it is one product, and it has a real user with real budgets:
        investigators, bounty hunters, and journalists who need a subject&rsquo;s footprint assembled without the
        subject &mdash; or anyone watching &mdash; ever learning who looked.
      </p>
      <div class="flex flex-wrap gap-3" data-reveal>
        <a href={PRODUCT.url} class="sc-button-accent" rel="noreferrer">Open {PRODUCT.name}</a>
        <a href="#waitlist" class="sc-button-secondary">Join the waitlist</a>
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper-warm">
    <div class="sc-container">
      <h2 class="font-serif text-3xl mb-4" data-reveal>Featured experience</h2>
      <p class="text-ink-muted max-w-[60ch] mb-8 leading-relaxed" data-reveal>
        Blindspot resolves an ENS name, runs Mobula inside an ephemeral sandbox, enriches off-chain context through a
        stealth browser, and delivers a verdict you can take with you &mdash; signed, and checkable by anyone holding
        the public key.
      </p>
      <div class="flex flex-wrap gap-3" data-reveal>
        <a href="/experiences#blindspot" class="sc-button-accent">Open the dossier</a>
        <a href="/recipes/blindspot" class="sc-button-secondary">Read the recipe</a>
      </div>
    </div>
  </section>

  <section id="waitlist" class="py-20">
    <div class="sc-container">
      <h2 class="font-serif text-3xl mb-4" data-reveal>Join the waitlist</h2>
      <p class="text-ink-muted max-w-[60ch] mb-8 leading-relaxed" data-reveal>
        We are building this for people who investigate things for a living. If that is you, tell us &mdash; we would
        rather have one real conversation than another month of guessing at what to build.
      </p>
      <form id="waitlist-form" class="flex flex-wrap gap-3 items-center max-w-[34rem]" data-reveal>
        <input
          id="waitlist-email"
          type="email"
          name="email"
          required
          placeholder="you@company.com"
          aria-label="Email address"
          class="flex-1 min-w-[14rem] px-4 py-3 border border-black/10 rounded-sc bg-paper text-ink"
        />
        <button type="submit" class="sc-button-accent">Notify me</button>
      </form>
      <p id="waitlist-status" class="text-ink-muted mt-4 text-sm" role="status"></p>
    </div>
  </section>
</Layout>

<script>
  // The waitlist and the analytics beacon are first-party: they post to the
  // Blindspot deployment, which stores the address and nothing else. No
  // cookies, no third party, no identifiers.
  import { PRODUCT } from "@scudra/shared"

  function beacon(name: string, meta?: Record<string, unknown>) {
    try {
      fetch(`${PRODUCT.url}/api/analytics`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, meta }),
        keepalive: true,
      })
    } catch {
      /* never let analytics break the page */
    }
  }

  beacon("page.view", { page: location.pathname })

  const form = document.getElementById("waitlist-form") as HTMLFormElement | null
  const status = document.getElementById("waitlist-status")
  form?.addEventListener("submit", async (e) => {
    e.preventDefault()
    const email = (document.getElementById("waitlist-email") as HTMLInputElement).value.trim()
    if (!email) return
    try {
      const res = await fetch(`${PRODUCT.url}/api/waitlist`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, source: "scudra.dev" }),
      })
      const body = await res.json()
      if (status) {
        status.textContent = body.ok
          ? body.already
            ? "You are already on the list — we will be in touch."
            : "Thank you. We will be in touch when there is something to try."
          : body.error || "That did not work. Try again in a moment."
      }
      if (body.ok) {
        form.reset()
        beacon("waitlist.joined", { source: "scudra.dev" })
      }
    } catch {
      if (status) status.textContent = "Could not reach the list. Try again in a moment."
    }
  })
</script>
