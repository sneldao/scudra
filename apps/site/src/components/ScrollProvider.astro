<script>
  import Lenis from "lenis"
  import { gsap } from "gsap"
  import { ScrollTrigger } from "gsap/ScrollTrigger"

  gsap.registerPlugin(ScrollTrigger)

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches

  const lenis = new Lenis({
    lerp: 0.1,
    duration: 1.2,
    smoothWheel: true,
  })

  lenis.on("scroll", ScrollTrigger.update)

  gsap.ticker.add((time) => {
    lenis.raf(time * 1000)
  })

  gsap.ticker.lagSmoothing(0)

  if (!prefersReducedMotion) {
    const reveals = document.querySelectorAll("[data-reveal]")
    reveals.forEach((el) => {
      // Stagger siblings (e.g. grid cards) slightly so reveals feel choreographed
      // rather than uniform; capped so long lists don't drag.
      const siblings = Array.from(el.parentElement?.querySelectorAll("[data-reveal]") ?? [])
      const order = siblings.indexOf(el)
      const delay = Math.min(order * 0.08, 0.4)
      gsap.fromTo(
        el,
        { opacity: 0, y: 24 },
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
          delay,
          ease: "power2.out",
          scrollTrigger: {
            trigger: el,
            start: "top 85%",
            toggleActions: "play none none none",
          },
        }
      )
    })
  }
</script>
