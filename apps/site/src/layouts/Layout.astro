---
import "@scudra/shared/styles/index.css"
import "../styles/global.css"
import Nav from "@scudra/shared/components/Nav.astro"
import Footer from "@scudra/shared/components/Footer.astro"
import ScrollProvider from "../components/ScrollProvider.astro"

interface Props {
  title?: string
  description?: string
}

const {
  title = "Scudra",
  description = "A lab for cloud-native agents. Recipes, experiences, and thought leadership for browsers, sandboxes, and desktops that run in the cloud.",
} = Astro.props
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <script is:inline>
      // Flag that JS is available before any stylesheet-driven reveal hides
      // content, so [data-reveal] only starts hidden when JS can reveal it.
      document.documentElement.classList.replace("no-js", "js")
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400&family=Inter:wght@400;500;600&family=JetBrains+Mono&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <ScrollProvider />
  </body>
</html>
