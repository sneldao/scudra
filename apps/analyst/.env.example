# --- Vultr Serverless Inference (OpenAI-compatible). Required for real runs. ---
# Model ids: curl -H "Authorization: Bearer $VULTR_INFERENCE_API_KEY" https://api.vultrinference.com/v1/models
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=
# Optional: a second model for the independent verifier pass. A different model
# family is ideal (the checker should not be the author). Defaults to the main model.
VULTR_INFERENCE_VERIFY_MODEL=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1

# --- Receipts: the key that signs each run -------------------------------
# Ed25519. The private key signs; the PUBLIC key is published at
# GET /api/verify, so a third party can verify a receipt without a secret
# and without trusting us.
#
# Generate a pair:
#   node -e "const {generateKeyPairSync}=require('crypto');const {privateKey,publicKey}=generateKeyPairSync('ed25519');console.log(privateKey.export({type:'pkcs8',format:'pem'}).toString());console.log(publicKey.export({type:'spki',format:'pem'}).toString())"
#
# Paste the private key here (\n escapes are expanded at load). The public
# key is derived from it automatically — configure it only if you want to
# publish a specific key.
RECEIPT_SIGNING_KEY=
RECEIPT_PUBLIC_KEY=

# --- Sandbox ---
SANDBOX_PROVIDER=docker
# Build with: docker build -t scudra-sandbox:latest apps/analyst/sandbox
SANDBOX_IMAGE=scudra-sandbox:latest
MAX_CONCURRENT_SANDBOXES=3

# Set to 1 ONLY when behind Caddy/nginx so per-IP rate limits see the real client.
TRUST_PROXY=0

# Dev only: scripted model + sandbox, no Docker and no API key (a banner shows in the UI).
# SCUDRA_MOCK=1   (or: pnpm dev:analyst:mock)
