# --- Solari (ephemeral sandbox + stealth browser) --------------------------
SOLARI_API_KEY=slr_live_...

# --- Mobula (onchain data) -------------------------------------------------
MOBULA_API_KEY=...

# --- Ethereum RPC (ENS resolution) ----------------------------------------
# Public RPC is fine: ENS resolution is not privacy-sensitive.
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com

# --- Storage: TWO databases, TWO audiences ---------------------------------
# The cases are the USER's documents — what we found about a SUBJECT. The
# subject's raw material expires on a TTL; the user's evidence persists.
BLINDSPOT_CASE_DB=data/cases.db

# Our own operational data: the waitlist (people who asked to be contacted)
# and coarse usage counters. We keep these; the case raw material expires.
# One file means one backup carries both policies, and one of them is wrong
# by the time the backup is restored.
BLINDSPOT_OPERATOR_DB=data/operator.db

# How long the subject's raw material survives, in hours.
BLINDSPOT_RAW_TTL_HOURS=24

# --- Receipt signing key ---------------------------------------------------
# Ed25519. The private key signs each case's receipt; the PUBLIC key is
# published at GET /api/verify so a third party can verify a receipt without
# a secret and without trusting us.
#
# A FILE, not an environment variable. A PEM is multi-line, and systemd's
# EnvironmentFile parser consumes the backslash in a "\n" escape, leaving a
# bare "n" and an unparseable key.
#
# Generate a pair:
#   node -e "const {generateKeyPairSync}=require('crypto');const {privateKey,publicKey}=generateKeyPairSync('ed25519');console.log(privateKey.export({type:'pkcs8',format:'pem'}).toString());console.log(publicKey.export({type:'spki',format:'pem'}).toString())"
#
# The public key is derived from the private one when it is not configured
# separately.
BLINDSPOT_SIGNING_KEY_FILE=/etc/scudra/blindspot-key.pem
BLINDSPOT_PUBLIC_KEY_FILE=/etc/scudra/blindspot-key.pub.pem

# --- Operator endpoint -----------------------------------------------------
# If this is NOT set, /api/stats REFUSES to serve rather than serving
# openly. An operator endpoint that quietly opens is worse than one that is
# missing.
BLINDSPOT_OPERATOR_KEY=
