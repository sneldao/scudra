---
import Layout from "../layouts/Layout.astro"
import CaseApp from "../components/CaseApp.tsx"
---

<Layout
  title="Blindspot — Evidence gathering that leaves the investigator invisible"
  description="Investigate an ENS name in throwaway infrastructure. Signed, checkable evidence; the trail does not survive."
>
  <CaseApp client:load />
</Layout>

<style is:global>
  /* ── The product surface ───────────────────────────────────────────────
     Deliberately plainer than the dossier. The dossier is the lab's
     language; this is the product's. One field, one button, one result. */

  .shell {
    max-width: 780px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }

  .masthead {
    margin-bottom: 3rem;
  }

  .eyebrow {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 0.75rem;
  }

  .masthead h1 {
    font-family: "Fraunces", Georgia, serif;
    font-size: clamp(2rem, 6vw, 2.9rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
    max-width: 20ch;
  }

  .lede {
    color: var(--ink-muted);
    font-size: 1.02rem;
    line-height: 1.65;
    max-width: 60ch;
    margin: 0 0 2rem;
  }

  .search {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .search input {
    flex: 1 1 16rem;
    font: inherit;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    padding: 0.8rem 1rem;
    border: 1px solid color-mix(in oklch, var(--ink) 18%, transparent);
    border-radius: 8px;
    background: var(--bg);
    color: var(--ink);
  }

  .search input:disabled {
    opacity: 0.6;
  }

  .search button,
  button.button,
  a.button {
    font: inherit;
    font-weight: 500;
    padding: 0.8rem 1.3rem;
    border-radius: 8px;
    border: 1px solid transparent;
    background: var(--accent);
    color: #fff;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
  }

  .search button:disabled,
  button.button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  button.ghost,
  a.button.ghost {
    background: transparent;
    color: var(--ink);
    border-color: color-mix(in oklch, var(--ink) 20%, transparent);
  }

  .hint {
    color: var(--ink-muted);
    font-size: 0.85rem;
    line-height: 1.6;
    margin: 0.85rem 0 0;
  }

  .steps {
    list-style: none;
    padding: 0;
    margin: 2rem 0;
    border-left: 2px solid color-mix(in oklch, var(--ink) 12%, transparent);
  }

  .steps li {
    padding: 0.35rem 0 0.35rem 1rem;
    color: var(--ink-dim);
    font-size: 0.92rem;
  }

  .steps li.active {
    color: var(--ink);
    font-weight: 500;
  }

  .steps li.done {
    color: var(--ink-muted);
  }

  .tick {
    display: inline-block;
    width: 1.4em;
    color: var(--accent);
  }

  .error {
    color: #b3261e;
    background: color-mix(in oklch, #b3261e 8%, transparent);
    border-left: 3px solid #b3261e;
    padding: 0.8rem 1rem;
    border-radius: 0 6px 6px 0;
  }

  .verdict {
    border: 1px solid color-mix(in oklch, var(--ink) 12%, transparent);
    border-radius: 12px;
    padding: 1.75rem;
    background: var(--bg-warm);
    margin: 2.5rem 0;
  }

  .verdict-head {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .verdict-head h2 {
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.5rem;
    margin: 0 0 0.25rem;
  }

  .verdict-head p {
    margin: 0.4rem 0 0;
    line-height: 1.6;
  }

  .score {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 1.1rem;
    font-weight: 700;
  }

  .score.big {
    font-size: 2.6rem;
    line-height: 1;
  }

  .score-high {
    color: #b3261e;
  }
  .score-mid {
    color: #a8620a;
  }
  .score-low {
    color: #1a7f37;
  }

  .label {
    font-family: "Inter", system-ui, sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--ink-muted);
    vertical-align: middle;
  }

  .mono {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.82rem;
  }

  .dim {
    color: var(--ink-muted);
  }

  .small {
    font-size: 0.8rem;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
    margin: 1.5rem 0;
    padding: 1rem 0;
    border-top: 1px solid color-mix(in oklch, var(--ink) 10%, transparent);
    border-bottom: 1px solid color-mix(in oklch, var(--ink) 10%, transparent);
    font-size: 0.85rem;
    color: var(--ink-muted);
  }

  .facts strong {
    display: block;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 1rem;
    color: var(--ink);
  }

  .warn {
    font-size: 0.85rem;
    color: #a8620a;
    background: color-mix(in oklch, #a8620a 8%, transparent);
    padding: 0.6rem 0.8rem;
    border-radius: 6px;
  }

  .signals {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0;
  }

  .signals li {
    border-left: 3px solid var(--ink-dim);
    padding: 0.5rem 0 0.5rem 0.9rem;
    margin-bottom: 0.6rem;
  }

  .signals li.sev-high {
    border-color: #b3261e;
  }
  .signals li.sev-medium {
    border-color: #a8620a;
  }
  .signals li.sev-low {
    border-color: #1a7f37;
  }

  .signal-head {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    flex-wrap: wrap;
  }

  .signals p {
    margin: 0.2rem 0 0;
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .sev {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .receipt,
  .sources {
    margin: 1.5rem 0;
    padding: 1rem 1.15rem;
    border: 1px solid color-mix(in oklch, var(--ink) 12%, transparent);
    border-radius: 8px;
    background: var(--bg);
  }

  .receipt h3,
  .sources h3 {
    font-size: 0.95rem;
    margin: 0 0 0.5rem;
  }

  .receipt-head {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    justify-content: space-between;
  }

  .sources ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sources li {
    padding: 0.4rem 0;
    border-bottom: 1px solid color-mix(in oklch, var(--ink) 8%, transparent);
  }

  .sources li:last-child {
    border-bottom: none;
  }

  .sources p {
    margin: 0.2rem 0 0;
  }

  .row {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 0.75rem;
  }

  .ok {
    color: #1a7f37;
    font-size: 0.85rem;
  }

  .bad {
    color: #b3261e;
    font-size: 0.85rem;
  }

  .actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin: 1.5rem 0;
  }

  .feedback {
    border-top: 1px solid color-mix(in oklch, var(--ink) 10%, transparent);
    padding-top: 1rem;
  }

  .feedback p {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
  }

  .chip {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklch, var(--ink) 18%, transparent);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  .chip.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .history {
    margin-top: 3.5rem;
  }

  .history-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .history h2 {
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.25rem;
    margin: 0 0 0.75rem;
  }

  .case-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .case-list li {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    border-bottom: 1px solid color-mix(in oklch, var(--ink) 8%, transparent);
    padding: 0.5rem 0;
  }

  .case-row {
    flex: 1;
    display: flex;
    gap: 0.9rem;
    align-items: baseline;
    flex-wrap: wrap;
    background: none;
    border: none;
    padding: 0.35rem 0;
    font: inherit;
    text-align: left;
    cursor: pointer;
    color: inherit;
  }

  .case-name {
    font-weight: 500;
  }

  .case-meta {
    font-size: 0.78rem;
    color: var(--ink-muted);
  }

  .link {
    background: none;
    border: none;
    font: inherit;
    font-size: 0.8rem;
    color: var(--ink-muted);
    cursor: pointer;
    text-decoration: underline;
    padding: 0;
  }

  .link.danger:hover {
    color: #b3261e;
  }

  .foot {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in oklch, var(--ink) 10%, transparent);
    font-size: 0.82rem;
    color: var(--ink-muted);
    line-height: 1.6;
  }

  .foot a {
    color: var(--ink);
  }
</style>
