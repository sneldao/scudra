---
import Layout from "../layouts/Layout.astro"
import BuilderApp from "../components/BuilderApp.tsx"
---

<Layout
  title="The Builder — Scudra"
  description="Prompt. Boot. Build. Vanish. An agent builds an app inside an ephemeral sandbox, hands you the live URL, then destroys the machine that hosted it."
>
  <main class="builder">
    <header class="builder-header">
      <p class="kicker">Scudra — The Builder</p>
      <h1>Software born and buried on stage.</h1>
      <p class="lede">
        Describe a small app. The Builder plans it, writes it, boots it inside
        a disposable sandbox, and hands you a live URL. One minute later, the
        machine that hosted it is destroyed — and the URL is a tombstone.
      </p>
    </header>
    <BuilderApp client:load />
    <footer class="builder-footer">
      <p>
        Nothing persists: no database, no storage, no residue.
        <a href="/recipes/the-builder">Read the recipe</a> —
        <a href="https://scudra.dev">Scudra</a>, built on
        <a href="https://getsolari.com">Solari</a>.
      </p>
    </footer>
  </main>
</Layout>

<style>
  .builder {
    max-width: 56rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
  }
  .kicker {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.72rem;
    color: var(--ink-muted);
    margin: 0 0 1rem;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 1rem;
  }
  .lede {
    color: var(--ink-muted);
    max-width: 44rem;
    line-height: 1.6;
  }
  .builder-footer {
    margin-top: 4rem;
    color: var(--ink-muted);
    font-size: 0.85rem;
  }
</style>
